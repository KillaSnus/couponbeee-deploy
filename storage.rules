rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Merchant logos and deal images are publicly readable
    match /merchants/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    match /deals/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }
  }
}
